//! Slint 界面：简洁中性的生产力工具风格（无角色立绘、无二次元主题）。
//!
//! 线程模型：
//!  - Slint 主线程只负责界面；
//!  - 一个 tokio 工作线程跑 Agent 与 PowerShell 桥接；
//!  - 两者之间只有 `UiBridge` 里的通道，**模型调用与进程 I/O 都不在主线程**。
//!
//! 取消语义：`取消` 只置一次取消标记，不打断正在跑的进程读写；
//! 等工作线程把"已中断"回报上来再恢复界面，避免界面说"停了"但后台还在动作。

// 只从 std-widgets 取 **ScrollView**（它只是 Flickable + 滚动条的组合，
// 不依赖主题调色板）。输入框与下拉框**自己实现**：
//
//   - `std-widgets` 的 `LineEdit` 把背景、边框、文字色**全部**取自主题
//     （`FluentPalette.control-background` / `foreground` …）。本项目**没有**
//     启用任何样式 feature（只有 `renderer-winit-software`），这些调色板值是
//     空的，于是输入框渲染成"看不见的框"、无边框、也就点不准。
//     这正是任务里"输入框必须始终可见并有点击区域"的根因。
//   - 同理，`Button` 也早就因为同样原因被换成了自绘的 `AppButton`。
//
// 现在统一改用内置的 `TextInput`（真实的文本编辑元素：支持输入法、复制粘贴、
// 选区、Tab 焦点链、password 类型），外面套一层我们自己画边框和焦点态的
// `AppLineEdit`。下拉框用 `PopupWindow` 展开完整列表并支持键盘上下选择。
import { ScrollView } from "std-widgets.slint";

// ---------------------------------------------------------------------------
// 数据模型
// ---------------------------------------------------------------------------

/// 一条对话记录（用户 / 助手 / 工具 / 系统提示）。
export struct ChatEntry {
    role: string,        // user | assistant | tool | system
    text: string,
    detail: string,      // 弱化的补充信息（工具成功/失败/耗时）
    tint: color,         // 气泡底色（由 Rust 侧按角色给定）
}

/// 会话列表的一行（PR8）。
export struct SessionRow {
    id: string,
    title: string,
    // 最近更新时间 + 回合状态（例如「11-03 20:41 · 已完成」）。
    detail: string,
    // 上一轮没有正常结束（取消 / 失败 / 进程中断）→ 用醒目色提示。
    warning: bool,
    selected: bool,
}

/// 工具调用卡片：界面上单独一块，便于看出它动屏幕到哪一步。
export struct ToolCard {
    name: string,
    state: string,       // running | ok | failed | denied
    detail: string,
    tint: color,
}

/// 自绘文本框：内置 `TextInput` 负责真正的编辑行为（输入法、复制粘贴、
/// 选区、Tab 焦点链、password），这里只画**边框、焦点态与点击区域**。
///
/// 为什么要自绘外壳：`std-widgets` 的 `LineEdit` 完全依赖主题调色板，
/// 本项目未启用样式 feature，结果是没有边框、文字不可见、也没有明确的可点区域。
/// `TextInput` 是内置元素（与样式无关），我们给它的 `color` 显式赋值，
/// 所以软件渲染器下也一定能看见。
component AppLineEdit inherits Rectangle {
    in-out property <string> text: "";
    in property <string> placeholder-text: "";
    in property <bool> input-type-password: false;
    in property <bool> enabled: true;
    callback accepted();
    // 用户真的改过内容（含输入法上屏、粘贴）；外层据此标记"未保存"。
    callback edited();

    height: 32px;
    border-radius: 5px;
    border-width: 1px;
    // 焦点边框用主色，未聚焦用中性色：焦点状态一眼可见。
    border-color: !enabled ? #e3e3e6 : (input.has-focus ? #1f6feb : #c9c9d0);
    background: !enabled ? #f5f5f7 : #ffffff;
    horizontal-stretch: 1;
    // 整个矩形都是输入区域：不用找特定像素，点哪里都能聚焦。
    forward-focus: input;
    accessible-role: text-input;
    accessible-value <=> input.text;
    accessible-placeholder-text: placeholder-text;
    accessible-enabled: enabled;

    input := TextInput {
        x: 9px;
        y: 0px;
        width: parent.width - 18px;
        height: parent.height;
        text <=> root.text;
        enabled: root.enabled;
        color: #1f1f22;
        selection-background-color: #cfe2ff;
        selection-foreground-color: #1f1f22;
        text-cursor-width: 1px;
        // 内置 `TextInput` 没有 `input-type` 之外的重置手段，枚举值写作
        // `InputType.password`（大小写敏感）。
        input-type: root.input-type-password ? InputType.password : InputType.text;
        font-size: 13px;
        vertical-alignment: center;

        accepted => { root.accepted(); }
        edited => { root.edited(); }
    }

    // 占位提示：`TextInput` 不提供 placeholder，这里在**文本为空**时叠一层
    // 灰色文字。它不接收点击（不挡输入），点它等于点下面的输入区。
    if root.text == "" && root.placeholder-text != "" : Text {
        x: 9px;
        width: parent.width - 18px;
        height: parent.height;
        text: root.placeholder-text;
        color: #a8a8b0;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
}

/// 一个"选项列表"下拉框：点开后展示**完整列表**（而不是逐个循环）。
///
/// 用 `PopupWindow` 承载列表（Slint 内置浮层，可超出父元素边界），
/// 选项用 `TouchArea` 自绘：不依赖 `ListView` 的主题样式。
/// 支持键盘：空格/回车展开，上下移动，回车确认，Esc 关闭。
component AppComboBox inherits Rectangle {
    in property <[string]> options: [];
    in-out property <int> index: 0;
    in property <bool> enabled: true;
    callback picked(int);

    height: 32px;
    border-radius: 5px;
    border-width: 1px;
    border-color: !enabled ? #e3e3e6 : (touch.has-hover ? #9aa4b2 : #c9c9d0);
    background: !enabled ? #f5f5f7 : #ffffff;
    horizontal-stretch: 1;
    forward-focus: keys;
    accessible-role: combobox;
    accessible-enabled: enabled;
    accessible-value: options.length > 0 && index >= 0 && index < options.length ? options[index] : "";

    function current-text() -> string {
        return (options.length > 0 && index >= 0 && index < options.length) ? options[index] : "";
    }
    function open() {
        if (enabled && options.length > 0) {
            popup.show();
        }
    }

    // 当前值
    Text {
        x: 9px;
        width: parent.width - 34px;
        height: parent.height;
        text: current-text();
        color: enabled ? #1f1f22 : #a8a8b0;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }

    // 展开箭头：直接用字形，不依赖图标主题或外部资源。
    Text {
        x: parent.width - 24px;
        width: 16px;
        height: parent.height;
        text: "▾";
        color: enabled ? #6b6b73 : #c0c0c6;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.open(); }
    }

    keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            // Slint 把不可打印键映射到 `Key` 命名空间的私有码点；
            // 这里只认空格/回车/上下箭头，其余放行（Tab 仍走焦点链）。
            if (event.text == " " || event.text == "\n") {
                root.open();
                return accept;
            }
            if (event.text == Key.DownArrow) {
                if (root.index < root.options.length - 1) {
                    root.index = root.index + 1;
                    root.picked(root.index);
                }
                return accept;
            }
            if (event.text == Key.UpArrow) {
                if (root.index > 0) {
                    root.index = root.index - 1;
                    root.picked(root.index);
                }
                return accept;
            }
            return reject;
        }
    }

    popup := PopupWindow {
        width: max(root.width, 180px);
        // 列表最多 8 项，超出由内部滚动（与设置面板一样不依赖 ScrollView）。
        height: min(list-layout.preferred-height, 8 * 30px) + 8px;
        x: 0;
        y: root.height + 2px;
        // 点列表项时由我们主动 close()；点外面则自动关闭。
        close-policy: close-on-click-outside;

        Rectangle {
            width: 100%;
            height: 100%;
            background: #ffffff;
            border-radius: 6px;
            border-width: 1px;
            border-color: #c9c9d0;

            list-layout := VerticalLayout {
                padding: 4px;

                for option[index] in root.options: Rectangle {
                    height: 30px;
                    border-radius: 4px;
                    background: option-touch.has-hover ? #eef3ff : (index == root.index ? #e6efff : transparent);

                    Text {
                        x: 8px;
                        width: parent.width - 16px;
                        height: parent.height;
                        text: option;
                        color: #1f1f22;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    option-touch := TouchArea {
                        clicked => {
                            root.index = index;
                            root.picked(index);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

/// 自绘按钮。
///
/// 不用 `std-widgets` 的 Button：它的外观由主题样式表决定，而我们在软件渲染器下
/// 没有随包发布样式表，按钮会渲染成"看不见的空白"。自绘一份，行为与外观都可控。
component AppButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();

    width: Math.max(64px, button-label.preferred-width + 24px);
    height: 30px;
    border-radius: 5px;
    border-width: 1px;
    border-color: !enabled ? #d8d8dd : (primary ? #1f6feb : #c9c9d0);
    background: !enabled ? #f0f0f2 : (primary ? #1f6feb : (touch.has-hover ? #f0f0f4 : #ffffff));

    button-label := Text {
        text: label;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: !enabled ? #a8a8b0 : (primary ? #ffffff : #1f1f22);
        font-size: 13px;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

/// 全局文本样式覆盖：软件渲染器下 `Text` 的默认前景色接近透明，
/// 不显式指定就会出现"字看不见"。这里把默认色钉死，各处仍可覆盖。
export global Theme {
    out property <color> text-color: #1f1f22;
    out property <color> muted-color: #6b6b73;
    out property <color> faint-color: #8a8a90;
}

export component AppWindow inherits Window {
    title: "Computer Use 语音助手（PR5 文本版）";
    preferred-width: 1020px;
    preferred-height: 760px;
    min-width: 720px;
    min-height: 480px;
    background: #f6f6f7;
    default-font-size: 13px;
    // 显式指定前景色：软件渲染器下默认主题色偏淡，正文会看不清。
    default-font-family: "Microsoft YaHei UI";

    // ---- 界面状态（Rust 侧同步） ----
    in-out property <[ChatEntry]> entries: [];
    in-out property <[ToolCard]> tools: [];
    in-out property <string> status: "就绪";
    in-out property <bool> busy: false;
    in-out property <string> endpoint-text: "未配置模型端点";
    in-out property <string> context-text: "";
    in-out property <string> draft: "";

    // ---- 会话（PR8） ----
    in-out property <[SessionRow]> sessions: [];
    in-out property <string> session-title: "（没有会话）";
    // 当前会话的"生效模型/有效窗口"摘要（只读展示）。
    in-out property <string> session-model-text: "";
    in-out property <string> session-effective-window: "";
    // 改名草稿与改名框开关（改名只作用于当前选中会话）。
    in-out property <string> rename-draft: "";
    in-out property <bool> rename-open: false;

    // ---- 输入区的模型选择（PR8：跨提供商） ----
    // `model-option-labels` 与 `model-choices` 一一对应；下拉只接受 [string]。
    in-out property <[string]> model-option-labels: [];
    in-out property <int> model-choice-index: -1;
    in-out property <[string]> reasoning-options: [];
    in-out property <int> reasoning-index: 0;
    in-out property <bool> reasoning-applicable: false;
    in-out property <string> model-hint: "";
    in-out property <string> manual-model: "";
    in-out property <bool> manual-model-open: false;

    // 设置区
    in-out property <bool> settings-open: false;
    in-out property <int> provider-index: 0;
    in-out property <string> base-url: "";
    in-out property <int> plan-edit-index: -1;
    in-out property <string> plan-edit-id;
    in-out property <string> plan-edit-name;
    in-out property <string> plan-edit-provider: "mimo";
    in-out property <string> plan-edit-model;
    in-out property <[string]> plan-edit-labels;
    callback edit-plan(index: int);
    callback store-plan();
    callback remove-plan();
    in-out property <string> model-plans-json;
    in-out property <string> model-schedule-json;
    in-out property <bool> schedule-enabled;
    in-out property <string> schedule-default;
    callback update-schedule();
    in-out property <[string]> rule-labels;
    in-out property <int> rule-index: -1;
    in-out property <string> rule-from: "09:00";
    in-out property <string> rule-to: "18:00";
    in-out property <string> rule-days;
    in-out property <string> rule-plan;
    callback edit-rule(index: int);
    callback store-rule();
    callback remove-rule();
    in-out property <string> model-name: "";
    in-out property <string> api-key-input: "";
    in-out property <bool> has-key: false;
    in-out property <int> permission-index: 0;
    // 保存失败的具体原因（空 = 没有错误）。设置页会把它显示在按钮上方，
    // 并且**不**关闭面板、**不**清空用户已输入的内容。
    in-out property <string> settings-error: "";
    // 是否有未保存的修改（任何输入框/下拉变化置真，保存或取消后清零）。
    in-out property <bool> settings-dirty: false;
    // 保存进行中：禁用保存按钮，避免重复提交；结果回来前界面照常可交互。
    in-out property <bool> settings-saving: false;

    // ---- 设置分类导航（PR8） ----
    in-out property <[string]> settings-tab-labels: [];
    in-out property <int> settings-tab-index: 0;
    // 最近审计（最新在前，每行一句可直接读的结论）。
    in-out property <[string]> audit-lines: [];
    // 权限：档位标签、逐能力覆盖（能力名 / 级别标签 / 当前选择索引）。
    in-out property <[string]> permission-mode-labels: [];
    in-out property <[string]> capability-labels: [];
    in-out property <[string]> override-labels: [];
    in-out property <[int]> override-indices: [];
    in-out property <bool> paused: false;
    in-out property <string> pause-hint: "";

    // ---- Agent 与上下文（PR8） ----
    in-out property <string> temperature: "0.3";
    in-out property <string> max-steps: "16";
    in-out property <string> timeout-ms: "60000";
    in-out property <string> context-window: "1000000";
    in-out property <string> compress-percent: "90";
    in-out property <string> context-hint: "";
    // 推理档位下拉的标签与当前索引 + 适用性（自定义端点不显示）。
    in-out property <[string]> thinking-labels: [];
    in-out property <[string]> effort-labels: [];
    in-out property <int> thinking-index: 0;
    in-out property <int> effort-index: 0;
    in-out property <bool> thinking-control-visible: false;
    in-out property <bool> effort-control-visible: false;
    in-out property <int> provider-hint-index: 0;

    // ---- 系统提示词（PR8） ----
    in-out property <bool> prompt-custom: false;
    in-out property <string> system-prompt: "";
    in-out property <string> default-prompt: "";
    in-out property <string> prompt-hint: "";

    // ---- 模型发现与连通性（PR8） ----
    in-out property <bool> models-busy: false;
    in-out property <string> model-list-hint: "";
    in-out property <[string]> discovered-models: [];
    in-out property <int> discovered-model-index: -1;
    in-out property <string> connection-hint: "";
    in-out property <string> connection-code: "";

    // 权限确认（ask）
    in-out property <bool> confirm-open: false;
    in-out property <string> confirm-tool: "";
    in-out property <string> confirm-label: "";
    in-out property <string> confirm-reason: "";
    in-out property <string> confirm-args: "";
    // 本次确认的请求 id：点按钮时原样回传，避免上一次确认的重复点击串到下一次。
    in-out property <int> confirm-request-id: 0;

    // 语音（PR6）：只暴露「用户能看懂」的几项，不做完整 HUD。
    in-out property <bool> voice-enabled: false;
    // off | loading | listening | capturing | transcribing | error
    in-out property <string> voice-state: "off";
    in-out property <string> voice-device: "";
    in-out property <string> voice-level: "";
    in-out property <string> voice-transcript: "";

    // 语音播报（PR7）：设置项 + 播放状态 + 字幕。
    in-out property <bool> tts-enabled: false;
    // 0 = 关闭（不播报），1 = MiMo 云端，2 = 本地 ONNX
    in-out property <int> tts-backend-index: 0;
    in-out property <string> tts-mimo-voice: "";
    in-out property <string> tts-mimo-style: "";
    in-out property <string> tts-local-dir: "";
    in-out property <string> tts-local-sid: "0";
    in-out property <string> tts-local-speed: "1.0";
    // 0 = 语音与文本都播报，1 = 只播语音提问，2 = 只播文本输入，3 = 都不自动播报
    in-out property <int> tts-speak-mode: 0;
    // 引擎是否可用（缺 Key / 缺模型时为 false，但设置仍然保留）
    in-out property <bool> tts-backend-ready: false;
    // **已保存并生效**的后端索引（与界面上的 tts-backend-index 区分：
    // 后者是用户当前的选择，可能还没保存）。试音据此说明用的是哪一份配置。
    in-out property <int> tts-active-backend-index: 0;
    // 已生效配置的文字描述（例如「MiMo mimo-v2.5-tts」/「关闭（不播报）」）。
    in-out property <string> tts-active-label: "";
    // 已生效配置是否可用（false = 引擎没建起来，试音会被拒绝）。
    in-out property <bool> tts-active-ready: false;
    // idle | synthesizing | buffering | playing | finished | stopped | failed | unavailable
    in-out property <string> speech-state: "idle";
    in-out property <string> speech-detail: "";
    in-out property <string> speech-subtitle: "";
    in-out property <bool> speech-active: false;

    // ---- 回调（Rust 侧实现） ----
    callback send(text: string);
    callback cancel-turn();

    // 会话（PR8）：id 为空 = 由 Rust 侧解析"当前会话"。
    callback new-session();
    callback select-session(id: string);
    callback rename-session(id: string, title: string);
    callback delete-session(id: string);
    callback open-rename();

    // 输入区的模型 / 推理档位（PR8）。
    callback model-choice-picked(index: int);
    callback reasoning-picked(index: int);
    callback apply-manual-model(model: string);

    // 设置分类导航（PR8）。
    callback settings-tab-picked(index: int);

    callback open-settings();
    // **一次保存**：模型端点、推理档位、提示词、权限与语音播报一起提交。
    // 界面上读全部字段，由 Rust 侧当作一个事务处理；结果通过
    // `settings-error` / `settings-saving` 回填，所以不需要参数与返回值。
    callback save-all();
    // 关闭设置面板（取消）：丢弃界面上的未保存修改。
    callback cancel-settings();
    // 带上界面当前选中的提供商索引：清除的是**用户看到的**那一家，
    // 不是已保存配置里的那一家。
    callback clear-api-key(provider-index: int);
    callback provider-changed(provider-index: int);
    // 权限：档位与单项覆盖**立即生效**（不等保存）；暂停/限时授权是运行态。
    callback permission-mode-picked(index: int);
    callback override-picked(row: int, choice: int);
    callback toggle-pause();
    in property <[string]> capability-ids;
    callback grant-capability(capability: string, minutes: int);
    callback export-audit();
    // 模型发现与连通性（PR8）。
    callback test-connection();
    callback fetch-models();
    callback confirm-decision(request-id: int, allow: bool);
    callback set-voice-enabled(enabled: bool);
    callback test-voice();
    callback stop-speaking();
    callback quit-app();

    // 状态 → 用户能看懂的中文（与 Rust 侧 VoiceState::label 保持一致的口径）。
    pure function voice-label(state: string) -> string {
        if (state == "loading") { return "正在加载语音模型…"; }
        if (state == "listening") { return "正在监听唤醒词"; }
        if (state == "capturing") { return "我在听，请说"; }
        if (state == "transcribing") { return "正在识别…"; }
        if (state == "error") { return "语音不可用"; }
        return "麦克风已关闭";
    }

    // ---- 布局 ----
    VerticalLayout {
        // 顶栏
        //
        // 高度用**固定值**而不是 `top-bar.preferred-height + 20px`：
        // 后者会让「父矩形高度 ← 子布局首选高度 ← 子布局受父高度约束」形成
        // binding loop（Slint 会警告"可能 panic"）。按钮本身固定 30px 高，
        // 加上下各 10px 内边距 = 50px，写死即可，也更稳定。
        Rectangle {
            background: #ffffff;
            height: 50px;

            top-bar := HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 12px;

                Text {
                    color: Theme.text-color;
                    text: "Computer Use 助手";
                    font-size: 15px;
                    font-weight: 600;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                // 端点摘要只是提示信息，按钮才是入口。它必须能被压缩：
                // `Text` 默认坚持自己的首选宽度，最小窗口（720px 逻辑宽）时会把
                // 「设置 / 退出」挤出右边缘——按钮就点不到了。
                // 用 `overflow: elide` + `min-width: 0px` 让它先让位。
                // 注意不要用 `if root.width >= …` 控制可见性：那会让布局反过来
                // 依赖窗口宽度，形成 layoutinfo binding loop（Slint 会警告可能 panic）。
                Text {
                    text: root.endpoint-text;
                    color: #666666;
                    vertical-alignment: center;
                    overflow: elide;
                    min-width: 0px;
                }

                AppButton {
                    label: root.voice-enabled ? "关闭麦克风" : "打开麦克风";
                    primary: root.voice-enabled;
                    clicked => { root.set-voice-enabled(!root.voice-enabled); }
                }

                // 只停声音：旁边的「取消」才会取消 Agent 任务。
                AppButton {
                    label: "停止播报";
                    enabled: root.speech-active;
                    clicked => { root.stop-speaking(); }
                }

                AppButton {
                    label: "设置";
                    clicked => { root.open-settings(); }
                }

                AppButton {
                    label: "退出";
                    clicked => { root.quit-app(); }
                }
            }
        }

        Rectangle { height: 1px; background: #e3e3e6; }

        // 主区域：会话栏 + 对话 + 右侧工具状态
        HorizontalLayout {
            spacing: 0;

            // ---- 会话栏（PR8） ----
            //
            // 宽度固定 210px：会话标题用 `elide` 截断，不让长标题把对话区挤窄。
            VerticalLayout {
                width: 210px;
                padding-left: 12px;
                padding-right: 10px;
                padding-top: 12px;
                padding-bottom: 10px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 6px;

                    Text {
                        color: Theme.text-color;
                        text: "会话";
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    AppButton {
                        label: "新建";
                        width: 58px;
                        clicked => { root.new-session(); }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    content-width: self.width;
                    content-height: session-list.preferred-height;

                    session-list := VerticalLayout {
                        spacing: 6px;

                        if root.sessions.length == 0 : Text {
                            text: "还没有会话。点「新建」开始。";
                            font-size: 11px;
                            color: #8a8a90;
                            wrap: word-wrap;
                        }

                        for row in root.sessions: Rectangle {
                            height: session-card.preferred-height + 12px;
                            border-radius: 6px;
                            background: row.selected ? #e6efff : (session-touch.has-hover ? #f2f2f4 : #ffffff);
                            border-width: 1px;
                            border-color: row.selected ? #b9d4ff : #e3e3e6;

                            session-card := VerticalLayout {
                                padding: 6px;
                                spacing: 2px;

                                Text {
                                    color: Theme.text-color;
                                    text: row.title;
                                    font-size: 12px;
                                    font-weight: 600;
                                    overflow: elide;
                                }
                                Text {
                                    text: row.detail;
                                    font-size: 10px;
                                    color: row.warning ? #a05a00 : #8a8a90;
                                    overflow: elide;
                                }
                            }

                            session-touch := TouchArea {
                                clicked => { root.select-session(row.id); }
                            }
                        }
                    }
                }

                // 当前会话的操作（忙碌时禁用：避免在回合执行中切换/删除）。
                HorizontalLayout {
                    spacing: 6px;

                    AppButton {
                        label: "改名";
                        width: 58px;
                        enabled: root.sessions.length > 0 && !root.busy;
                        clicked => { root.open-rename(); }
                    }

                    AppButton {
                        label: "删除";
                        width: 58px;
                        enabled: root.sessions.length > 0 && !root.busy;
                        // 空 id = 由 Rust 侧解析为当前会话。
                        clicked => { root.delete-session(""); }
                    }
                }

                if root.rename-open : Rectangle {
                    height: rename-box.preferred-height + 12px;
                    border-radius: 6px;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: #c9c9d0;

                    rename-box := VerticalLayout {
                        padding: 6px;
                        spacing: 6px;

                        AppLineEdit {
                            text <=> root.rename-draft;
                            placeholder-text: "会话标题";
                            accepted => {
                                root.rename-session("", root.rename-draft);
                                root.rename-open = false;
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;

                            Rectangle { horizontal-stretch: 1; }

                            AppButton {
                                label: "取消";
                                width: 52px;
                                clicked => { root.rename-open = false; }
                            }

                            AppButton {
                                label: "确定";
                                primary: true;
                                width: 52px;
                                clicked => {
                                    root.rename-session("", root.rename-draft);
                                    root.rename-open = false;
                                }
                            }
                        }
                    }
                }
            }

            Rectangle { width: 1px; background: #e3e3e6; }

            // 对话
            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                // 当前会话标题：一眼看出在跟哪个会话说话。
                Text {
                    color: Theme.text-color;
                    text: root.session-title;
                    font-size: 14px;
                    font-weight: 600;
                    overflow: elide;
                }

                ScrollView {
                    content-width: self.width;
                    content-height: transcript.preferred-height;

                    transcript := VerticalLayout {
                        spacing: 8px;

                        for entry in root.entries: timeline-row := Rectangle {
                            property <bool> expanded: false;
                            height: bubble.preferred-height + 16px;
                            border-radius: 8px;
                            background: entry.tint;
                            border-width: 1px;
                            border-color: #e3e3e6;

                            bubble := VerticalLayout {
                                padding: 8px;
                                spacing: 2px;

                                Text {
                                    text: entry.role;
                                    font-size: 11px;
                                    color: #8a8a90;
                                }
                                if entry.role == "思考": AppButton {
                                    label: timeline-row.expanded ? "收起思考" : "展开思考";
                                    clicked => { timeline-row.expanded = !timeline-row.expanded; }
                                }
                                Text {
                                    visible: entry.role != "思考" || timeline-row.expanded;
                                    text: entry.text;
                                    wrap: word-wrap;
                                    color: #1f1f22;
                                }
                                if entry.detail != "" : Text {
                                    text: entry.detail;
                                    font-size: 11px;
                                    color: #8a8a90;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        if root.entries.length == 0 && root.tools.length == 0 : Text {
                            text: "还没有对话。在下面输入指令，或点「打开麦克风」用语音。";
                            font-size: 12px;
                            color: #8a8a90;
                            wrap: word-wrap;
                        }
                    }
                }

                // 语音状态条（不加 HUD：只显示状态与识别出的最终文字）
                if root.voice-enabled : Rectangle {
                    height: voice-row.preferred-height + 12px;
                    border-radius: 6px;
                    background: root.voice-state == "error" ? #fdeeee : #ffffff;
                    border-width: 1px;
                    border-color: #e3e3e6;

                    voice-row := HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 10px;

                        Text {
                            text: voice-label(root.voice-state);
                            font-size: 12px;
                            color: root.voice-state == "error" ? #a02020 : #1f1f22;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.voice-level;
                            font-size: 11px;
                            color: #8a8a90;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if root.voice-transcript != "" : Text {
                            text: "识别：" + root.voice-transcript;
                            font-size: 12px;
                            color: #1f1f22;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                // 播报状态 + 字幕（简洁一行，不做完整 HUD）
                if root.speech-detail != "" || root.speech-subtitle != "" : Rectangle {
                    height: speech-row.preferred-height + 12px;
                    border-radius: 6px;
                    background: root.speech-state == "failed" ? #fdeeee : #ffffff;
                    border-width: 1px;
                    border-color: #e3e3e6;

                    speech-row := HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 10px;

                        Text {
                            text: root.speech-detail;
                            font-size: 12px;
                            color: root.speech-state == "failed" ? #a02020 : #1f1f22;
                            vertical-alignment: center;
                        }
                        if root.speech-subtitle != "" : Text {
                            text: "“" + root.speech-subtitle + "”";
                            font-size: 12px;
                            color: #55555c;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                }

                // ---- 输入区的模型 / 推理档位（PR8） ----
                //
                // 这一行显示"这一轮会用哪家哪模型"：跨提供商，选中后只改当前
                // 会话的选择并持久化。执行中禁用（不热切换正在跑的回合）。
                HorizontalLayout {
                    spacing: 8px;

                    AppComboBox {
                        width: 280px;
                        enabled: !root.busy && root.model-option-labels.length > 0;
                        options: root.model-option-labels;
                        index: root.model-choice-index;
                        picked(index) => { root.model-choice-picked(index); }
                    }

                    // 推理档位只对声明了协议的提供商显示（自定义端点不注入专属字段）。
                    if root.reasoning-applicable : AppComboBox {
                        width: 160px;
                        enabled: !root.busy && root.reasoning-options.length > 0;
                        options: root.reasoning-options;
                        index: root.reasoning-index;
                        picked(index) => { root.reasoning-picked(index); }
                    }

                    AppButton {
                        label: "手填模型";
                        width: 82px;
                        enabled: !root.busy;
                        clicked => { root.manual-model-open = !root.manual-model-open; }
                    }

                    Rectangle { horizontal-stretch: 1; }
                }

                if root.manual-model-open : HorizontalLayout {
                    spacing: 8px;

                    AppLineEdit {
                        text <=> root.manual-model;
                        placeholder-text: "输入模型名（在线目录里没有也能用）";
                        accepted => {
                            root.apply-manual-model(root.manual-model);
                            root.manual-model-open = false;
                        }
                    }

                    AppButton {
                        label: "使用";
                        primary: true;
                        width: 64px;
                        clicked => {
                            root.apply-manual-model(root.manual-model);
                            root.manual-model-open = false;
                        }
                    }
                }

                // 当前生效来源（会话手选 / 时段方案 / 全局默认）或"缺 Key"的提示。
                if root.model-hint != "" : Text {
                    text: root.model-hint;
                    font-size: 11px;
                    color: #a05a00;
                    wrap: word-wrap;
                }

                // 输入区
                HorizontalLayout {
                    spacing: 8px;

                    AppLineEdit {
                        text <=> root.draft;
                        placeholder-text: root.busy ? "正在执行…" : "说点什么，例如：列出当前窗口";
                        enabled: !root.busy;
                        accepted => {
                            if (!root.busy && root.draft != "") {
                                root.send(root.draft);
                            }
                        }
                    }

                    AppButton {
                        label: root.busy ? "取消" : "发送";
                        primary: true;
                        width: 88px;
                        clicked => {
                            if (root.busy) {
                                root.cancel-turn();
                            } else if (root.draft != "") {
                                root.send(root.draft);
                            }
                        }
                    }
                }

                Text {
                    text: root.context-text;
                    font-size: 11px;
                    color: #8a8a90;
                }
            }

            Rectangle { width: 1px; background: #e3e3e6; }

            // 工具状态
            VerticalLayout {
                width: 300px;
                padding: 16px;
                spacing: 8px;

                Text {
                    color: Theme.text-color;
                    text: "工具调用";
                    font-weight: 600;
                }

                ScrollView {
                    content-width: self.width;
                    content-height: tool-list.preferred-height;

                    tool-list := VerticalLayout {
                        spacing: 6px;

                        if root.tools.length == 0 : Text {
                            text: "还没有工具调用。";
                            font-size: 12px;
                            color: #8a8a90;
                            wrap: word-wrap;
                        }

                        for tool in root.tools: Rectangle {
                            height: card.preferred-height + 12px;
                            border-radius: 6px;
                            background: tool.tint;
                            border-width: 1px;
                            border-color: #e3e3e6;

                            card := VerticalLayout {
                                padding: 6px;
                                spacing: 2px;

                                Text {
                                    color: Theme.text-color;
                                    text: tool.name + "  ·  " + tool.state;
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: tool.detail;
                                    font-size: 11px;
                                    color: #55555c;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }

        // 状态栏
        Rectangle { height: 1px; background: #e3e3e6; }
        Rectangle {
            background: #ffffff;
            height: 32px;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;

                Text {
                    text: root.status;
                    font-size: 12px;
                    color: #55555c;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }
    }


    // ---- 设置面板（覆盖层） ----
    //
    // 布局要点（对应任务书第 3 条）：
    //  - 主体内容放进 **Flickable**，窗口变矮或高 DPI 放大时整页可滚动；
    //  - 底部操作栏（取消/保存/错误提示）**固定**在面板底部，永远可见；
    //  - 面板高度取 min(内容高度, 可用高度)，不会撑出窗口，也不会把
    //    正在编辑的输入框顶到不可见处；
    //  - 半透明遮罩本身接收点击，避免误触到后面的对话区。
    if root.settings-open : Rectangle {
        background: #00000055;
        // 吃掉落在遮罩上的点击：设置打开时不应"点穿"到下面的对话区。
        TouchArea { }

        panel := Rectangle {
            width: min(600px, parent.width - 48px);
            // 高度用**固定上限**而不是"内容首选高度"：`ScrollView` 不会把内部
            // 内容的 preferred-height 传播出来（它只报自己的最小值），
            // 用内容高度算会把面板压扁、把下面的字段裁掉。
            // 取 min(期望高度, 窗口可用高度)，保证：
            //  - 窗口够大时面板高度稳定，主体区域有足够可视高度；
            //  - 窗口变矮 / 高 DPI 放大时面板仍然整体在窗口内，内容改为滚动。
            height: min(700px, parent.height - 48px);
            border-radius: 10px;
            background: #ffffff;
            border-width: 1px;
            border-color: #d8d8dd;

            VerticalLayout {
                // 标题栏（固定）
                Rectangle {
                    background: #ffffff;
                    height: 52px;

                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 16px;
                        spacing: 8px;

                        Text {
                            color: Theme.text-color;
                            text: "设置";
                            font-size: 16px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        if root.settings-dirty : Text {
                            text: "未保存";
                            font-size: 11px;
                            color: #a05a00;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle { height: 1px; background: #e3e3e6; }

                // ---- 分类导航（PR8） ----
                //
                // 标签宽度按文字自适应（用 `tab-text.preferred-width`），
                // 不使用固定宽度：中文标签"Agent 与上下文"比"权限"宽得多。
                Rectangle {
                    background: #fafafb;
                    height: 42px;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 4px;

                        for label[index] in root.settings-tab-labels: Rectangle {
                            width: tab-label.preferred-width + 22px;
                            height: 30px;
                            border-radius: 5px;
                            background: index == root.settings-tab-index ? #e6efff : (tab-touch.has-hover ? #f0f0f4 : transparent);
                            border-width: 1px;
                            border-color: index == root.settings-tab-index ? #b9d4ff : transparent;

                            tab-label := Text {
                                text: label;
                                font-size: 12px;
                                color: Theme.text-color;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            tab-touch := TouchArea {
                                clicked => {
                                    // **先在本侧立即切换**：分类导航是纯界面状态，
                                    // 不该等工作线程往返——它可能正忙，那时"点了没反应"
                                    // 会让人以为界面卡住。
                                    root.settings-tab-index = index;
                                    root.settings-tab-picked(index);
                                }
                            }
                        }

                        Rectangle { horizontal-stretch: 1; }
                    }
                }

                Rectangle { height: 1px; background: #e3e3e6; }

                // 可滚动主体
                settings-scroll := ScrollView {
                    vertical-stretch: 1;

                    settings-body := VerticalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        padding-top: 14px;
                        padding-bottom: 14px;
                        spacing: 10px;

                        // ===== 0. 模型 / 方案 =====
                        if root.settings-tab-index == 0 : VerticalLayout {
                            Text { text: "模型方案"; color: Theme.text-color; }
                            HorizontalLayout {
                                AppComboBox { options: root.plan-edit-labels; index: root.plan-edit-index; picked(i) => { root.edit-plan(i); } }
                                AppButton { label: "新建"; clicked => { root.edit-plan(-1); } }
                                AppButton { label: "更新方案草稿"; clicked => { root.store-plan(); } }
                                AppButton { label: "删除方案"; clicked => { root.remove-plan(); } }
                            }
                            HorizontalLayout {
                                AppLineEdit { text <=> root.plan-edit-id; placeholder-text: "方案 ID"; }
                                AppLineEdit { text <=> root.plan-edit-name; placeholder-text: "名称"; }
                                AppLineEdit { text <=> root.plan-edit-provider; placeholder-text: "mimo / deepseek / openai-compatible"; }
                                AppLineEdit { text <=> root.plan-edit-model; placeholder-text: "模型名称"; }
                            }
                            HorizontalLayout {
                                AppButton { label: root.schedule-enabled ? "时段切换：已启用" : "时段切换：已禁用"; clicked => { root.schedule-enabled = !root.schedule-enabled; root.update-schedule(); } }
                                AppLineEdit { text <=> root.schedule-default; placeholder-text: "默认方案 ID（留空跟随全局）"; edited => { root.update-schedule(); } }
                            }
                            Text { text: "时段规则（星期 1–7，逗号分隔；留空表示每天）"; color: Theme.text-color; }
                            HorizontalLayout {
                                AppComboBox { options: root.rule-labels; index: root.rule-index; picked(i) => { root.edit-rule(i); } }
                                AppButton { label: "新规则"; clicked => { root.edit-rule(-1); } }
                                AppButton { label: "更新规则草稿"; clicked => { root.store-rule(); } }
                                AppButton { label: "删除规则"; clicked => { root.remove-rule(); } }
                            }
                            HorizontalLayout {
                                AppLineEdit { text <=> root.rule-from; placeholder-text: "开始 HH:mm"; }
                                AppLineEdit { text <=> root.rule-to; placeholder-text: "结束 HH:mm"; }
                                AppLineEdit { text <=> root.rule-days; placeholder-text: "星期，例如 1,2,3,4,5"; }
                                AppLineEdit { text <=> root.rule-plan; placeholder-text: "方案 ID"; }
                            }


                            spacing: 10px;

                            Text {
                                color: Theme.text-color;
                                text: "模型端点";
                                font-size: 14px;
                                font-weight: 600;
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "提供商"; width: 88px; vertical-alignment: center; color: Theme.text-color; }
                                AppComboBox {
                                    enabled: !root.settings-saving;
                                    options: ["mimo", "deepseek", "openai-compatible"];
                                    // 注意 `index:` 是**单向**绑定：下拉自己会先改内部的
                                    // `index`，这里必须同时把值写回 `root.provider-index`，
                                    // 否则界面显示的提供商与保存出去的 provider_id 会不一致
                                    // （选 DeepSeek 却存成 MiMo，Key 也会写到错误的那家名下）。
                                    index <=> root.provider-index;
                                    picked(index) => {
                                    root.settings-dirty = true;
                                    root.settings-error = "";
                                    root.provider-changed(index);
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: "地址"; width: 88px; vertical-alignment: center; color: Theme.text-color; }
                            AppLineEdit {
                                enabled: !root.settings-saving;
                                text <=> root.base-url;
                                placeholder-text: "https://…";
                                edited => { root.settings-dirty = true; root.settings-error = ""; }
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: "模型"; width: 88px; vertical-alignment: center; color: Theme.text-color; }
                            AppLineEdit {
                                enabled: !root.settings-saving;
                                text <=> root.model-name;
                                placeholder-text: "模型名";
                                edited => { root.settings-dirty = true; root.settings-error = ""; }
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: "API Key"; width: 88px; vertical-alignment: center; color: Theme.text-color; }
                            AppLineEdit {
                                enabled: !root.settings-saving;
                                text <=> root.api-key-input;
                                placeholder-text: root.has-key ? "已保存（留空则不修改）" : "未保存";
                                input-type-password: true;
                                edited => { root.settings-dirty = true; root.settings-error = ""; }
                            }
                        }


                        Rectangle { height: 1px; background: #e3e3e6; }

                        Text {
                            color: Theme.text-color;
                            text: "语音播报";
                            font-size: 14px;
                            font-weight: 600;
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: "播报后端"; width: 88px; vertical-alignment: center; color: Theme.text-color; }
                            AppComboBox {
                                enabled: !root.settings-saving;
                                options: ["关闭", "MiMo 云端", "本地 ONNX"];
                                index <=> root.tts-backend-index;
                                picked(index) => {
                                    root.tts-enabled = index != 0;
                                    root.settings-dirty = true;
                                    root.settings-error = "";
                                }
                            }
                            Text {
                                text: root.tts-backend-ready ? "可用" : "不可用";
                                font-size: 11px;
                                color: root.tts-backend-ready ? #1f7a3a : #a02020;
                                vertical-alignment: center;
                            }
                        }

                        // 明确区分「当前生效」与「尚未保存的选择」：
                        // 上面下拉是用户的选择，这一行是真正在跑的那份配置。
                        if root.settings-dirty : Text {
                            text: "当前生效：" + root.tts-active-label;
                            font-size: 11px;
                            color: #a05a00;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: "云端音色"; width: 88px; vertical-alignment: center; color: Theme.text-color; }
                            AppLineEdit {
                                enabled: !root.settings-saving;
                                text <=> root.tts-mimo-voice;
                                placeholder-text: "留空 = 服务端默认预置音色";
                                edited => { root.settings-dirty = true; root.settings-error = ""; }
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: "风格指令"; width: 88px; vertical-alignment: center; color: Theme.text-color; }
                            AppLineEdit {
                                enabled: !root.settings-saving;
                                text <=> root.tts-mimo-style;
                                placeholder-text: "可选，例如：语速稍快，语气自然（<120 字）";
                                edited => { root.settings-dirty = true; root.settings-error = ""; }
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: "本地模型"; width: 88px; vertical-alignment: center; color: Theme.text-color; }
                            AppLineEdit {
                                enabled: !root.settings-saving;
                                text <=> root.tts-local-dir;
                                placeholder-text: "留空 = 数据目录 models/kokoro-multi-lang-v1_0";
                                edited => { root.settings-dirty = true; root.settings-error = ""; }
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: "音色/语速"; width: 88px; vertical-alignment: center; color: Theme.text-color; }
                            AppLineEdit {
                                enabled: !root.settings-saving;
                                text <=> root.tts-local-sid;
                                placeholder-text: "音色编号";
                                width: 110px;
                                edited => { root.settings-dirty = true; root.settings-error = ""; }
                            }
                            AppLineEdit {
                                enabled: !root.settings-saving;
                                text <=> root.tts-local-speed;
                                placeholder-text: "语速 0.5~2.0";
                                width: 130px;
                                edited => { root.settings-dirty = true; root.settings-error = ""; }
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: "自动播报"; width: 88px; vertical-alignment: center; color: Theme.text-color; }
                            AppComboBox {
                                enabled: !root.settings-saving;
                                options: ["语音与文本", "只播语音", "只播文本", "都不自动"];
                                index <=> root.tts-speak-mode;
                                picked(index) => {
                                    root.settings-dirty = true;
                                    root.settings-error = "";
                                }
                            }
                        }

                        Text {
                            text: "云端模式会把助手回复的正文发送给 MiMo 合成语音（需要 MiMo 账户的 Key，不会借用其它提供商的 Key）；本地 ONNX 模式不联网，但需要自己准备模型文件。模型端点与语音播报在同一份配置里，一次保存生效。";
                            font-size: 11px;
                            color: #8a8a90;
                            wrap: word-wrap;
                        }

                        Rectangle { height: 1px; background: #e3e3e6; }

                        // ---- 模型发现与连通性 ----
                        Text {
                            color: Theme.text-color;
                            text: "连通性与模型发现";
                            font-size: 13px;
                            font-weight: 600;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            AppButton {
                                label: "测试连接";
                                enabled: !root.settings-saving && !root.models-busy;
                                clicked => { root.test-connection(); }
                            }
                            AppButton {
                                label: root.models-busy ? "获取中…" : "获取模型";
                                enabled: !root.settings-saving && !root.models-busy;
                                clicked => { root.fetch-models(); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        if root.connection-hint != "" : Text {
                            text: root.connection-hint;
                            font-size: 11px;
                            color: root.connection-code == "ok" ? #1f7a3a : (root.connection-code == "auth" ? #a02020 : #a05a00);
                            wrap: word-wrap;
                        }

                        if root.model-list-hint != "" : Text {
                            text: root.model-list-hint;
                            font-size: 11px;
                            color: #55555c;
                            wrap: word-wrap;
                        }

                        if root.discovered-models.length > 0 : HorizontalLayout {
                            spacing: 10px;
                            Text { text: "在线模型"; width: 88px; vertical-alignment: center; color: Theme.text-color; }
                            AppComboBox {
                                enabled: !root.settings-saving;
                                options: root.discovered-models;
                                index <=> root.discovered-model-index;
                                picked(index) => {
                                    // 选中就填进模型输入框（用户随后保存；
                                    // 不会偷偷改掉已生效配置）。
                                    if index >= 0 && index < root.discovered-models.length {
                                        root.model-name = root.discovered-models[index];
                                        root.settings-dirty = true;
                                        root.settings-error = "";
                                    }
                                }
                            }
                        }

                        Text {
                            text: "「获取模型」只查询 /models 目录：成功不等于模型能聊天，失败也不妨碍手填模型名。「测试连接」会真的发一次最小对话请求，据此区分授权 / 模型 / 网络问题。";
                            font-size: 11px;
                            color: #8a8a90;
                            wrap: word-wrap;
                        }
                        }

                        // ===== 1. Agent 与上下文 =====
                        if root.settings-tab-index == 1 : VerticalLayout {
                            spacing: 10px;

                            Text {
                                color: Theme.text-color;
                                text: "采样与步数";
                                font-size: 14px;
                                font-weight: 600;
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "温度"; width: 100px; vertical-alignment: center; color: Theme.text-color; }
                                AppLineEdit {
                                    text <=> root.temperature;
                                    placeholder-text: "0~2";
                                    width: 120px;
                                    edited => { root.settings-dirty = true; root.settings-error = ""; }
                                }
                                Text {
                                    text: "思考模式下部分型号会忽略温度（服务端强制覆盖）";
                                    font-size: 11px;
                                    color: #8a8a90;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "最大步数"; width: 100px; vertical-alignment: center; color: Theme.text-color; }
                                AppLineEdit {
                                    text <=> root.max-steps;
                                    placeholder-text: "1~40";
                                    width: 120px;
                                    edited => { root.settings-dirty = true; root.settings-error = ""; }
                                }
                                Text {
                                    text: "一步 = 一次模型往返（可含多个工具调用）";
                                    font-size: 11px;
                                    color: #8a8a90;
                                    vertical-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "超时(ms)"; width: 100px; vertical-alignment: center; color: Theme.text-color; }
                                AppLineEdit {
                                    text <=> root.timeout-ms;
                                    placeholder-text: "5000~600000";
                                    width: 120px;
                                    edited => { root.settings-dirty = true; root.settings-error = ""; }
                                }
                            }

                            Rectangle { height: 1px; background: #e3e3e6; }

                            Text {
                                color: Theme.text-color;
                                text: "上下文预算";
                                font-size: 14px;
                                font-weight: 600;
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "窗口(tokens)"; width: 100px; vertical-alignment: center; color: Theme.text-color; }
                                AppLineEdit {
                                    text <=> root.context-window;
                                    placeholder-text: "默认 1000000";
                                    width: 140px;
                                    edited => { root.settings-dirty = true; root.settings-error = ""; }
                                }
                                AppLineEdit {
                                    text <=> root.compress-percent;
                                    placeholder-text: "压缩触发 %";
                                    width: 120px;
                                    edited => { root.settings-dirty = true; root.settings-error = ""; }
                                }
                            }

                            Text {
                                text: root.context-hint;
                                font-size: 11px;
                                color: #55555c;
                                wrap: word-wrap;
                            }

                            Text {
                                text: "默认 1,000,000 tokens、到 90% 才压缩。模型有可信且更小的窗口元数据时按更小的算（只收紧、不放宽）。低于触发点绝不提前丢历史。";
                                font-size: 11px;
                                color: #8a8a90;
                                wrap: word-wrap;
                            }
                        }

                        // ===== 2. 系统提示词 =====
                        if root.settings-tab-index == 2 : VerticalLayout {
                            spacing: 10px;

                            Text {
                                color: Theme.text-color;
                                text: "系统提示词";
                                font-size: 14px;
                                font-weight: 600;
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "模式"; width: 100px; vertical-alignment: center; color: Theme.text-color; }
                                AppComboBox {
                                    options: ["使用内置默认", "使用自定义"];
                                    index: root.prompt-custom ? 1 : 0;
                                    picked(index) => {
                                        root.prompt-custom = index == 1;
                                        root.settings-dirty = true;
                                        root.prompt-hint = "";
                                    }
                                }
                            }

                            if root.prompt-custom : AppLineEdit {
                                text <=> root.system-prompt;
                                placeholder-text: "整段替换：这里的内容就是模型收到的人设（不会偷偷拼回默认设定）";
                                edited => { root.settings-dirty = true; root.settings-error = ""; }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                AppButton {
                                    label: "复制默认提示词";
                                    clicked => {
                                        // 复制走 Rust 侧的剪贴板命令；失败会如实提示。
                                        root.prompt-hint = "复制中…";
                                    }
                                }
                                AppButton {
                                    label: "恢复默认";
                                    clicked => {
                                        root.system-prompt = root.default-prompt;
                                        root.settings-dirty = true;
                                        root.prompt-hint = "已填入默认提示词（保存后生效）";
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }

                            if root.prompt-hint != "" : Text {
                                text: root.prompt-hint;
                                font-size: 11px;
                                color: #a05a00;
                                wrap: word-wrap;
                            }

                            Text {
                                text: "提示词不决定工具能不能执行——那是权限的事。改完保存，下一轮请求立刻生效。";
                                font-size: 11px;
                                color: #8a8a90;
                                wrap: word-wrap;
                            }
                        }

                        // ===== 3. 权限 =====
                        if root.settings-tab-index == 3 : VerticalLayout {
                            spacing: 10px;

                            Text {
                                color: Theme.text-color;
                                text: "权限档位";
                                font-size: 14px;
                                font-weight: 600;
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "档位"; width: 100px; vertical-alignment: center; color: Theme.text-color; }
                                AppComboBox {
                                    enabled: !root.settings-saving;
                                    options: root.permission-mode-labels;
                                    index <=> root.permission-index;
                                    picked(index) => {
                                        root.settings-dirty = true;
                                        root.settings-error = "";
                                        root.permission-mode-picked(index);
                                    }
                                }
                            }

                            Text {
                                text: "「免确认」= 已知且可授权的工具都不再询问（含删除、执行命令）。未知工具仍拒绝；全局暂停仍优先；下面的单项覆盖仍可把它掰回询问/拒绝。";
                                font-size: 11px;
                                color: #a02020;
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                AppButton {
                                    label: root.paused ? "恢复操作" : "暂停 10 分钟";
                                    primary: root.paused;
                                    clicked => { root.toggle-pause(); }
                                }
                                Text {
                                    text: root.pause-hint;
                                    font-size: 11px;
                                    color: #a05a00;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }

                            Rectangle { height: 1px; background: #e3e3e6; }

                            Text {
                                color: Theme.text-color;
                                text: "逐能力覆盖（跟随档位 = 不覆盖）";
                                font-size: 13px;
                                font-weight: 600;
                            }

                            for row[index] in root.capability-labels: HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: row;
                                    width: 120px;
                                    vertical-alignment: center;
                                    color: Theme.text-color;
                                    font-size: 12px;
                                }
                                AppComboBox {
                                    enabled: !root.settings-saving;
                                    width: 120px;
                                    options: root.override-labels;
                                    index: index < root.override-indices.length ? root.override-indices[index] : 0;
                                    picked(choice) => { root.override-picked(index, choice); }
                                }
                                AppButton {
                                    label: "限时允许";
                                    enabled: !root.settings-saving;
                                    width: 84px;
                                    clicked => { root.grant-capability(root.capability-ids[index], 15); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }

                            Text {
                                text: "「限时允许」只作用于本会话：不写盘、重启失效、不跨会话泄漏；它只能把「询问」提升为「允许」，不会解开「拒绝」或未知工具。";
                                font-size: 11px;
                                color: #8a8a90;
                                wrap: word-wrap;
                            }

                            Rectangle { height: 1px; background: #e3e3e6; }

                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    color: Theme.text-color;
                                    text: "最近审计";
                                    font-size: 13px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                AppButton {
                                    label: "导出全部";
                                    clicked => { root.export-audit(); }
                                }
                            }

                            Rectangle {
                                height: 150px;
                                border-radius: 6px;
                                background: #fafafb;
                                border-width: 1px;
                                border-color: #e3e3e6;

                                ScrollView {
                                    content-width: self.width;
                                    content-height: audit-list.preferred-height;

                                    audit-list := VerticalLayout {
                                        padding: 6px;
                                        spacing: 2px;
                                        for line in root.audit-lines: Text {
                                            text: line;
                                            font-size: 11px;
                                            color: #55555c;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }

                        // ===== 4. 语音输入 / 播报 =====
                        if root.settings-tab-index == 4 : VerticalLayout {
                            spacing: 10px;

                            Text {
                                color: Theme.text-color;
                                text: "语音输入";
                                font-size: 14px;
                                font-weight: 600;
                            }

                            Text {
                                text: "语音输入走本机 Whisper 与唤醒词模型，完全离线；设备与模型状态显示在主界面状态条。这里不提供尚未实现的开关。";
                                font-size: 11px;
                                color: #8a8a90;
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                AppButton {
                                    label: root.voice-enabled ? "关闭麦克风" : "打开麦克风";
                                    primary: root.voice-enabled;
                                    clicked => { root.set-voice-enabled(!root.voice-enabled); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }

                            Text {
                                text: root.voice-device;
                                font-size: 11px;
                                color: #55555c;
                                wrap: word-wrap;
                            }

                            Rectangle { height: 1px; background: #e3e3e6; }

                            Text {
                                color: Theme.text-color;
                                text: "语音播报";
                                font-size: 14px;
                                font-weight: 600;
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "播报后端"; width: 100px; vertical-alignment: center; color: Theme.text-color; }
                                AppComboBox {
                                    enabled: !root.settings-saving;
                                    options: ["关闭", "MiMo 云端", "本地 ONNX"];
                                    index <=> root.tts-backend-index;
                                    picked(index) => {
                                        root.tts-enabled = index != 0;
                                        root.settings-dirty = true;
                                        root.settings-error = "";
                                    }
                                }
                                Text {
                                    text: root.tts-backend-ready ? "可用" : "不可用";
                                    font-size: 11px;
                                    color: root.tts-backend-ready ? #1f7a3a : #a02020;
                                    vertical-alignment: center;
                                }
                            }

                            // 明确区分「当前生效」与「尚未保存的选择」。
                            if root.settings-dirty : Text {
                                text: "当前生效：" + root.tts-active-label;
                                font-size: 11px;
                                color: #a05a00;
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "云端音色"; width: 100px; vertical-alignment: center; color: Theme.text-color; }
                                AppLineEdit {
                                    enabled: !root.settings-saving;
                                    text <=> root.tts-mimo-voice;
                                    placeholder-text: "留空 = 服务端默认预置音色";
                                    edited => { root.settings-dirty = true; root.settings-error = ""; }
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "风格指令"; width: 100px; vertical-alignment: center; color: Theme.text-color; }
                                AppLineEdit {
                                    enabled: !root.settings-saving;
                                    text <=> root.tts-mimo-style;
                                    placeholder-text: "可选，例如：语速稍快（<120 字）";
                                    edited => { root.settings-dirty = true; root.settings-error = ""; }
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "本地模型"; width: 100px; vertical-alignment: center; color: Theme.text-color; }
                                AppLineEdit {
                                    enabled: !root.settings-saving;
                                    text <=> root.tts-local-dir;
                                    placeholder-text: "留空 = 数据目录 models/kokoro-multi-lang-v1_0";
                                    edited => { root.settings-dirty = true; root.settings-error = ""; }
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "音色/语速"; width: 100px; vertical-alignment: center; color: Theme.text-color; }
                                AppLineEdit {
                                    enabled: !root.settings-saving;
                                    text <=> root.tts-local-sid;
                                    placeholder-text: "音色编号";
                                    width: 110px;
                                    edited => { root.settings-dirty = true; root.settings-error = ""; }
                                }
                                AppLineEdit {
                                    enabled: !root.settings-saving;
                                    text <=> root.tts-local-speed;
                                    placeholder-text: "语速 0.5~2.0";
                                    width: 130px;
                                    edited => { root.settings-dirty = true; root.settings-error = ""; }
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "自动播报"; width: 100px; vertical-alignment: center; color: Theme.text-color; }
                                AppComboBox {
                                    enabled: !root.settings-saving;
                                    options: ["语音与文本", "只播语音", "只播文本", "都不自动"];
                                    index <=> root.tts-speak-mode;
                                    picked(index) => {
                                        root.settings-dirty = true;
                                        root.settings-error = "";
                                    }
                                }
                            }

                            Text {
                                text: "云端模式会把助手回复的**正文**发给 MiMo 合成语音（只用 MiMo 账户的 Key，不会借用其它提供商）；本地 ONNX 不联网，但需要自己准备模型。思考内容与工具 JSON 永远不朗读。";
                                font-size: 11px;
                                color: #8a8a90;
                                wrap: word-wrap;
                            }

                            Text {
                                text: "当前版本没有音乐控制与联网搜索，相关设置在迁移对照里明确标注为后续实现。";
                                font-size: 11px;
                                color: #8a8a90;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: #e3e3e6; }

                // 固定底部操作栏：错误提示 + 试音 + 清除 Key + 取消/保存
                footer := VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 10px;
                    padding-bottom: 14px;
                    spacing: 8px;

                    // 保存失败的具体原因：就地显示，不关闭面板、不清空输入。
                    if root.settings-error != "" : Rectangle {
                        height: error-text.preferred-height + 12px;
                        border-radius: 5px;
                        background: #fdeeee;
                        border-width: 1px;
                        border-color: #f0c0c0;

                        error-text := Text {
                            x: 8px;
                            y: 6px;
                            width: parent.width - 16px;
                            text: root.settings-error;
                            font-size: 12px;
                            color: #a02020;
                            wrap: word-wrap;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        AppButton {
                            label: "试音";
                            // 试音只作用于**已保存生效**的配置：未保存的选择不会生效，
                            // 也不能让"改了下拉就试音"制造出与实际播报不符的假象。
                            enabled: root.tts-active-ready && !root.settings-dirty && !root.settings-saving;
                            clicked => { root.test-voice(); }
                        }

                        AppButton {
                            label: "停止播报";
                            enabled: root.speech-active;
                            clicked => { root.stop-speaking(); }
                        }

                        AppButton {
                            label: "清除已保存的 Key";
                            enabled: root.has-key && !root.settings-saving;
                            clicked => { root.clear-api-key(root.provider-index); }
                        }

                        Rectangle { horizontal-stretch: 1; }
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        Rectangle { horizontal-stretch: 1; }

                        AppButton {
                            label: "取消";
                            // 保存进行中禁用：已经开始执行的保存无法撤销，
                            // 允许点击会造成"取消了但配置仍被写入"的假象。
                            enabled: !root.settings-saving;
                            clicked => { root.cancel-settings(); }
                        }

                        AppButton {
                            // 保存是**异步**的：点击后立刻置「保存中」并禁用相关控件，
                            // 结果由 Rust 侧回填（成功关面板 / 失败就地显示原因）。
                            // 不在 UI 线程上等待，否则落盘和重建 TTS 会卡住界面。
                            label: root.settings-saving ? "保存中…" : "保存";
                            primary: true;
                            enabled: !root.settings-saving;
                            clicked => {
                                // **一次**提交：界面上读全部字段，由 Rust 侧按
                                // "要么都生效、要么如实报错"处理（不需要参数）。
                                root.settings-saving = true;
                                root.save-all();
                            }
                        }
                    }
                }
            }
        }
    }

    // ---- 权限确认面板（ask） ----
    if root.confirm-open : Rectangle {
        background: #00000055;

        Rectangle {
            width: min(480px, parent.width - 64px);
            height: confirm-layout.preferred-height + 40px;
            border-radius: 10px;
            background: #ffffff;
            border-width: 1px;
            border-color: #d8d8dd;

            confirm-layout := VerticalLayout {
                padding: 20px;
                spacing: 10px;

                Text {
                    color: Theme.text-color;
                    text: "需要你确认";
                    font-size: 15px;
                    font-weight: 600;
                }

                Text {
                    color: Theme.text-color;
                    text: root.confirm-label + "（" + root.confirm-tool + "）";
                    wrap: word-wrap;
                }

                if root.confirm-reason != "" : Text {
                    text: root.confirm-reason;
                    color: #a05a00;
                    wrap: word-wrap;
                }

                if root.confirm-args != "" : Text {
                    text: "参数：" + root.confirm-args;
                    font-size: 11px;
                    color: #8a8a90;
                    wrap: word-wrap;
                }

                Text {
                    text: "拒绝的话这一步不会执行，它也不会用别的办法绕过。";
                    font-size: 11px;
                    color: #8a8a90;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;

                    Rectangle { horizontal-stretch: 1; }

                    AppButton {
                        label: "拒绝";
                        clicked => { root.confirm-decision(root.confirm-request-id, false); }
                    }

                    AppButton {
                        label: "允许";
                        primary: true;
                        clicked => { root.confirm-decision(root.confirm-request-id, true); }
                    }
                }
            }
        }
    }
}
