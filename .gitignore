# 依赖与构建产物
node_modules/
dist/
build/

# 本机配置（含 API 密钥，绝不入库）
.config/

# 模型权重（体积大，按需下载）
# 默认唤醒词不放在这里：唯一来源是 packages/voice/kws-keywords.default.txt，
# 运行时复制到用户数据目录；models/kws-keywords.txt 只作为旧安装的迁移输入。
models/

# 运行期产物
packages/cua/frames/
*.log
*.err

# 参考仓库（克隆自上游，不入库）
refs/

# 临时
tmp/
*.tmp
.tmp/

# 语音运行时与音色包（体积大，且含第三方版权模型，不入库）
.runtime/

# Electron 壳运行期产物
apps/shell/shell.log
tools/__pycache__/
